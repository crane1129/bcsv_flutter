<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark mode gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0F172A"
                android:centerColor="#1E293B"
                android:endColor="#334155"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Dark mode church icon -->
    <item android:gravity="center" android:top="120dp">
        <layer-list>
            <!-- Dark shadow -->
            <item android:top="8dp" android:left="8dp">
                <shape android:shape="oval">
                    <size android:width="120dp" android:height="120dp" />
                    <solid android:color="#40000000" />
                </shape>
            </item>
            
            <!-- Dark icon background -->
            <item>
                <shape android:shape="oval">
                    <size android:width="120dp" android:height="120dp" />
                    <solid android:color="#1E293B" />
                    <stroke android:width="3dp" android:color="#6366F1" />
                </shape>
            </item>
            
            <!-- Church icon (dark mode) -->
            <item android:top="30dp" android:left="30dp" android:right="30dp" android:bottom="30dp">
                <bitmap 
                    android:src="@drawable/splash"
                    android:gravity="center"
                    android:tint="#6366F1" />
            </item>
        </layer-list>
    </item>
    
    <!-- Dark mode branding card -->
    <item android:gravity="center|bottom" android:bottom="120dp">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="#30000000" />
                    <size android:width="320dp" android:height="80dp" />
                </shape>
            </item>
            
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="#1E293B" />
                    <stroke android:width="1dp" android:color="#475569" />
                    <size android:width="320dp" android:height="80dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>
