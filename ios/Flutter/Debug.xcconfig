#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Xcode's newer "User Script Sandboxing" blocks Flutter's build-phase
// script (flutter assemble) from writing files like .last_build_id
// that aren't declared as explicit script outputs.
ENABLE_USER_SCRIPT_SANDBOXING = NO
